        "rinder",
        "=kalb",
        "kalbs",
        "=lamm",
        "lammfleisch",
        "hähnchen",
        "=huhn",
        "=pute",
        "puten",
        "truthahn",
        "geflügel",
        "=ente",
        "=gans",
        "=wild",
        "hirsch",
        "=wurst",
        "salami",
        "=chicken",
        "=beef",
        "=veal",
        "=lamb",
        "=mutton",
        "=turkey",
        "=poulet",
        "=boeuf",
        "fleischextrakt",
        "fleischbrühe",
        "collagen",
        "kollagen",
        "hühnerfleisch",
        "hühnerbrühe",
        "hühnerbrust",
        "hühnerleber",
