    },
    {
      "id": "flavour-alcohol-carrier",
      "level": "doubtful",
      "label": "Flavour carrier may be alcohol",
      "note": "Flavours (Aroma) may use ethanol as carrier; certified products avoid this.",
      "match": [
        "=arrak",
        "rum-aroma",
        "rumaroma",
        "wein-aroma",
        "weinaroma"
      ],
      "except": [],
      "cosmetic_level": "doubtful",
      "label_de": "Aroma evtl. mit Alkohol",
      "note_de": "Aromen können Ethanol als Trägerstoff enthalten; zertifizierte Produkte vermeiden das."
    },
    {
      "id": "shellfish-lab-insects",
      "level": "doubtful",
      "label": "Insects",
      "note": "Insect ingredients are disputed among schools of thought.",
      "match": [
        "mehlwurm",
        "insektenpulver",
        "insect powder",
        "grillenmehl",
        "cricket powder",
        "=e904",
        "schellack",
