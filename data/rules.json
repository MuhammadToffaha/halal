{
  "version": "2026-10-21",
  "_help": "Ingredient rules. match: text contained in the ingredient list (lowercase). '=word' = whole word only. except: phrases removed before matching. vegan_ok: skip rule if product is marked vegan/vegetarian on Open Food Facts. Edit on GitHub -> app picks it up automatically. cosmetic_level: level used for cosmetics (Open Beauty Facts). label_de / note_de: German texts.",
  "rules": [
    {
      "id": "pork",
      "level": "haram",
      "label": "Pork / Schwein",
      "note": "Pork and all pork derivatives are haram.",
      "match": [
        "schwein",
        "=pork",
        "=porc",
        "varken",
        "maiale",
        "speck",
        "bacon",
        "=lard",
        "saindoux",
        "=jambon",
        "prosciutto",
        "pancetta",
        "=ham",
        "porcine",
        "=sus scrofa"
      ],
      "except": [],
      "label_de": "Schwein",
      "note_de": "Schwein und alle Schweine-Bestandteile sind haram."
    },
    {
      "id": "ham-de",
      "level": "haram",
      "label": "Schinken (ham, usually pork)",
      "note": "In Germany 'Schinken' without an animal named is pork.",
      "match": [
        "schinken"
      ],
      "except": [
        "putenschinken",
        "geflügelschinken",
        "truthahnschinken",
        "hähnchenschinken",
        "hühnerschinken",
        "rinderschinken",
        "kalbsschinken",
        "lachsschinken vom rind"
      ],
      "label_de": "Schinken (meist Schwein)",
      "note_de": "„Schinken“ ohne Tierangabe ist in Deutschland Schwein."
    },
    {
      "id": "lard-de",
      "level": "haram",
      "label": "Schmalz (lard)",
      "note": "Plain 'Schmalz' is pork lard.",
      "match": [
        "schmalz"
      ],
      "except": [
        "butterschmalz",
        "gänseschmalz",
        "pflanzenschmalz",
        "kokosschmalz",
        "rinderschmalz",
        "entenschmalz"
      ],
      "label_de": "Schmalz",
      "note_de": "Reines „Schmalz“ ist Schweineschmalz."
    },
    {
      "id": "gelatine",
      "level": "haram",
      "label": "Gelatine",
      "note": "In Germany gelatine is mostly pork unless the source (fish / halal beef) is stated.",
      "match": [
        "gelatine",
        "gelatin",
        "gélatine",
        "=e441",
        "gelatina"
      ],
      "except": [
        "fischgelatine",
        "fish gelatin",
        "fish gelatine",
        "gelatine (fisch",
        "gelatine aus fisch",
        "halal gelatine",
        "halal-gelatine",
        "halalgelatine",
        "rindergelatine",
        "beef gelatin",
        "beef gelatine",
        "gelatine (rind",
        "gelatine vom rind",
        "gelatine aus rind"
      ],
      "label_de": "Gelatine",
      "note_de": "In Deutschland meist vom Schwein, außer Quelle (Fisch / Halal-Rind) ist angegeben."
    },
    {
      "id": "alcohol",
      "level": "haram",
      "label": "Alcohol / Alkohol",
      "note": "Alcohol as an ingredient is not permitted by European halal certifiers. In cosmetics (external use) many scholars accept synthetic alcohol — shown as doubtful.",
      "match": [
        "alkohol",
        "alcohol",
        "ethanol",
        "=wein",
        "rotwein",
        "weißwein",
        "weisswein",
        "dessertwein",
        "portwein",
        "branntwein",
        "weinbrand",
        "=wine",
        "=vin",
        "=rum",
        "rumaroma",
        "=bier",
        "=beer",
        "likör",
        "liqueur",
        "eierlikör",
        "=sekt",
        "champagner",
        "=cognac",
        "=brandy",
        "=whisky",
        "=whiskey",
        "=wodka",
        "=vodka",
        "=gin",
        "kirschwasser",
        "=amaretto",
        "=marsala",
        "=sherry",
        "=calvados",
        "=grappa",
        "spirituose",
        "=sake",
        "=mirin"
      ],
      "except": [
        "alkoholfrei",
        "alcohol-free",
        "alcohol free",
        "zuckeralkohol",
        "sugar alcohol",
        "ohne alkohol",
        "weinstein",
        "weinsäure",
        "weinessig",
        "weintraube",
        "wine vinegar",
        "vinaigre de vin",
        "bierhefe",
        "brewer's yeast",
        "beer yeast"
      ],
      "cosmetic_level": "doubtful",
      "label_de": "Alkohol",
      "note_de": "Alkohol als Zutat wird von europäischen Halal-Zertifizierern nicht akzeptiert. In Kosmetik (äußerlich) akzeptieren viele Gelehrte synthetischen Alkohol — daher dort zweifelhaft."
    },
    {
      "id": "carmine",
      "level": "haram",
      "label": "Carmine / Karmin (E120)",
      "note": "Insect-derived red colour; not accepted by most halal certifiers.",
      "match": [
        "=e120",
        "karmin",
        "carmin",
        "cochenille",
        "cochineal",
        "karminsäure",
        "carminic"
      ],
      "except": [],
      "label_de": "Karmin (E120)",
      "note_de": "Roter Farbstoff aus Insekten; von den meisten Halal-Zertifizierern nicht akzeptiert."
    },
    {
      "id": "blood",
      "level": "haram",
      "label": "Blood / Blut",
      "note": "Blood and blood products are haram.",
      "match": [
        "=blut",
        "blutwurst",
        "blutplasma",
        "blood plasma",
        "=blood"
      ],
      "except": [
        "blutorange",
        "blood orange"
      ],
      "label_de": "Blut",
      "note_de": "Blut und Blutprodukte sind haram."
    },
    {
      "id": "beef-gelatine",
      "level": "doubtful",
      "label": "Beef gelatine",
      "note": "Halal only if from halal-slaughtered cattle — look for a certificate.",
      "match": [
        "rindergelatine",
        "beef gelatin",
        "beef gelatine",
        "gelatine (rind",
        "gelatine vom rind",
        "gelatine aus rind"
      ],
      "except": [],
      "label_de": "Rindergelatine",
      "note_de": "Nur halal, wenn von halal geschlachteten Rindern — auf Zertifikat achten."
    },
    {
      "id": "emulsifiers",
      "level": "doubtful",
      "label": "Emulsifiers (may be animal fat)",
      "note": "E470–E495 / mono- & diglycerides can come from pork fat unless stated plant-based.",
      "match": [
        "=e470a",
        "=e470b",
        "=e471",
        "=e472a",
        "=e472b",
        "=e472c",
        "=e472d",
        "=e472e",
        "=e472f",
        "=e473",
        "=e474",
        "=e475",
        "=e477",
        "=e478",
        "=e481",
        "=e482",
        "=e483",
        "=e491",
        "=e492",
        "=e493",
        "=e494",
        "=e495",
        "mono- und diglyceride",
        "mono- and diglycerides",
        "monoglyceride",
        "diglyceride",
        "mono- et diglycérides"
      ],
      "except": [
        "pflanzliche mono- und diglyceride",
        "e471 (pflanzlich)",
        "e471 (aus pflanzlichen fetten)",
        "e471 aus pflanzlichen fetten",
        "mono- und diglyceride von speisefettsäuren (pflanzlich)",
        "mono- und diglyceride von speisefettsäuren aus pflanzlichen fetten",
        "mono- and diglycerides of fatty acids (vegetable)"
      ],
      "vegan_ok": true,
      "label_de": "Emulgatoren (evtl. tierisch)",
      "note_de": "E470–E495 / Mono- & Diglyceride können aus Schweinefett stammen, wenn nicht pflanzlich angegeben."
    },
    {
      "id": "glycerol",
      "level": "doubtful",
      "label": "Glycerin (E422)",
      "note": "Can be animal-derived unless plant source stated.",
      "match": [
        "=e422",
        "glycerin",
        "glycerol",
        "glycérol"
      ],
      "except": [
        "pflanzliches glycerin",
        "vegetable glycerin",
        "glycerin (pflanzlich",
        "glycerinester von baumharz",
        "glycerinester aus wurzelharz",
        "glycerinester von holzharzen"
      ],
      "vegan_ok": true,
      "label_de": "Glycerin (E422)",
      "note_de": "Kann tierisch sein, wenn keine pflanzliche Quelle angegeben ist."
    },
    {
      "id": "cysteine",
      "level": "doubtful",
      "label": "L-Cysteine (E920)",
      "note": "Often made from feathers or hair.",
      "match": [
        "=e920",
        "l-cystein",
        "l-cysteine",
        "cystein"
      ],
      "except": [],
      "vegan_ok": true,
      "label_de": "L-Cystein (E920)",
      "note_de": "Wird oft aus Federn oder Haaren gewonnen."
    },
    {
      "id": "stearic",
      "level": "doubtful",
      "label": "Stearic acid / stearates (E570, E572)",
      "note": "May be animal fat.",
      "match": [
        "=e570",
        "=e572",
        "stearinsäure",
        "stearic acid",
        "magnesiumstearat",
        "magnesium stearate"
      ],
      "except": [],
      "vegan_ok": true,
      "label_de": "Stearinsäure / Stearate (E570, E572)",
      "note_de": "Kann aus tierischem Fett stammen."
    },
    {
      "id": "bone",
      "level": "doubtful",
      "label": "Bone phosphate (E542)",
      "note": "Made from animal bones.",
      "match": [
        "=e542",
        "knochenphosphat",
        "bone phosphate",
        "knochen"
      ],
      "except": [],
      "label_de": "Knochenphosphat (E542)",
      "note_de": "Aus Tierknochen hergestellt."
    },
    {
      "id": "rennet",
      "level": "doubtful",
      "label": "Animal rennet / Lab",
      "note": "Calf rennet is halal only from halal-slaughtered animals; microbial rennet is fine.",
      "match": [
        "=lab",
        "tierisches lab",
        "kälberlab",
        "=rennet",
        "=présure",
        "=pepsin"
      ],
      "except": [
        "mikrobielles lab",
        "mikrobiellem lab",
        "mikrobieller lab",
        "microbial rennet",
        "vegetarisches lab",
        "pflanzliches lab",
        "lab (mikrobiell"
      ],
      "vegan_ok": true,
      "label_de": "Tierisches Lab",
      "note_de": "Kälberlab nur halal von halal geschlachteten Tieren; mikrobielles Lab ist unbedenklich."
    },
    {
      "id": "animal-fat",
      "level": "doubtful",
      "label": "Animal fat",
      "note": "Source animal / slaughter unknown.",
      "match": [
        "tierische fette",
        "tierisches fett",
        "tierischer fett",
        "animal fat",
        "=talg",
        "rindertalg",
        "tallow",
        "hühnerfett",
        "rinderfett"
      ],
      "except": [],
      "vegan_ok": true,
      "label_de": "Tierisches Fett",
      "note_de": "Tierart / Schlachtung unbekannt."
    },
    {
      "id": "meat",
      "level": "doubtful",
